<?xml version="1.0"?>
<robot name="robmini" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 添加参数声明 -->
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="namespace" default=""/>
    <xacro:arg name="use_mock" default="false"/>
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="sim_drive_mode" default="planar"/>  <!-- /ros2_control-->
    <xacro:arg name="controller_config" default=""/>

    
    <!-- 获取参数值 -->
    <xacro:property name="prefix" value="$(arg prefix)" />
    <xacro:property name="ros_namespace" value="$(arg namespace)" />
    <xacro:property name="use_mock" value="$(arg use_mock)" />
    <xacro:property name="use_gazebo" value="$(arg use_gazebo)" />
    <xacro:property name="sim_drive_mode" value="$(arg sim_drive_mode)" />
    <xacro:property name="controller_config" value="$(arg controller_config)" />

    <!-- TF 前缀处理保持不变 -->
    <xacro:if value="${prefix == '/' or prefix == '' or prefix == ' '}">
        <xacro:property name="tf_prefix" value="" />
    </xacro:if>
    <xacro:unless value="${prefix == '/' or prefix == '' or prefix == ' '}">
        <xacro:property name="tf_prefix" value="${prefix}/" />
    </xacro:unless>

    <!-- 使用传统 find 语法 -->
    <xacro:include filename="$(find robmini_description)/urdf/robmini.urdf.xacro" />
    <xacro:include filename="$(find robmini_description)/urdf/lidar_gazebo.xacro" />
    <xacro:include filename="$(find robmini_description)/urdf/robmini.ros2_control.xacro" />
    <!-- 宏调用保持不变 -->
    <!-- <robmini/> -->
    <xacro:robmini_ros2_control
    use_mock_bool="${str(use_mock).lower() in ['true', '1', 'yes', 'on']}"
    use_gazebo_bool="${str(use_gazebo).lower() in ['true', '1', 'yes', 'on']}"
    sim_drive_mode="${sim_drive_mode}"
    controller_config="${controller_config}"
    ros_namespace="${ros_namespace}"
    frame_prefix="${tf_prefix}" />
</robot>
